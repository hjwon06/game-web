<% content_for :title, "첫 계정 만들기" %>
<div class="card">
  <h2>첫 계정 만들기</h2>
  <p class="hint">처음 한 번만 만드는 관리자 계정입니다.</p>
  <%
    messages = if @user && @user.errors.any?
      @user.errors.map do |error|
        case [error.attribute, error.type]
        when [:name, :blank] then "이름을 입력해 주세요"
        when [:name, :taken] then "이미 있는 이름입니다"
        when [:password_confirmation, :confirmation] then "비밀번호가 서로 다릅니다"
        when [:password, :blank] then "비밀번호를 입력해 주세요"
        else error.full_message
        end
      end.uniq
    end
  %>
  <% if messages.present? %>
    <div class="error" role="alert">
      <ul>
        <% messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form_with url: setup_path, method: :post, local: true do |f| %>
    <div class="field">
      <%= f.label :name, "이름", for: "name" %>
      <%= f.text_field :name, id: "name", value: params[:name], required: true, autofocus: true,
            autocomplete: "username", autocapitalize: "none", spellcheck: false %>
    </div>
    <div class="field">
      <%= f.label :password, "비밀번호", for: "password" %>
      <%= f.password_field :password, id: "password", required: true, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "비밀번호 확인", for: "password_confirmation" %>
      <%= f.password_field :password_confirmation, id: "password_confirmation", required: true, autocomplete: "new-password" %>
    </div>
    <%= f.submit "계정 만들고 시작", class: "btn", data: { disable_with: false } %>
  <% end %>
</div>
